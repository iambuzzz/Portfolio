# Server-side only (never prefix with VITE_). Set the same variables in
# Vercel → Project → Settings → Environment Variables.
GROQ_API_KEY=

# Public by design: Web3Forms keys can only send mail to the owner's address.
VITE_WEB3FORMS_KEY=

# Google Maps Embed API key (Maps app). Restrict it to your domains + Maps Embed API.
VITE_GOOGLE_MAPS_KEY=
